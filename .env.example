# PostgreSQL. Compose использует внутренний адрес postgres:5432.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=spark
POSTGRES_USER=spark
POSTGRES_PASSWORD=example-postgres-password

# Подпись JWT. Для prod сгенерируйте свой SECRET_KEY.
SECRET_KEY=example-only-jwt-signing-key-replace-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Адреса для профиля dev.
API_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:5174
# Для профиля prod замените оба адреса:
# API_BASE_URL=/api/v1
# FRONTEND_BASE_URL=https://sparkwork.dpdns.org

# Redis. Приложение и Celery используют внутренний адрес redis:6379.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=example-redis-default-password
REDIS_USER=spark
REDIS_USER_PASSWORD=example-redis-spark-password

# OpenAI-совместимый API локальной Ollama.
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_MODEL=qwen3:0.6b
OPENAI_API_KEY=ollama

# Yandex Object Storage. Примеры заменяются реквизитами вашего бакета.
YANDEX_CLOUD_KEY_ID=example-yandex-key-id
YANDEX_CLOUD_KEY=example-yandex-secret-key
BUCKET_NAME=example-spark-bucket
ENDPOINT_URL=https://storage.yandexcloud.net

# SMTP. Для Gmail задайте пароль приложения в PASSWORD_EMAIL.
LOGIN_EMAIL=smtp-user@example.invalid
FROM_EMAIL=spark@example.invalid
PASSWORD_EMAIL=example-smtp-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
